# Токены двух разных ботов от @BotFather. Не публикуйте заполненный .env.
STORE_BOT_TOKEN=
BUYBACK_BOT_TOKEN=

# Ваши числовые Telegram ID. Несколько ID — через запятую.
# При пустом списке доступны только /id и сообщение о закрытом доступе.
STORE_TESTER_IDS=
BUYBACK_TESTER_IDS=

# У каждого бота отдельная база. Пути считаются от папки проекта.
STORE_DB=.data/store.sqlite3
BUYBACK_DB=.data/buyback.sqlite3
